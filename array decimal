/*
*arrays-set of homogenous data items ,all of same kind.
*all int or all double and similarly other types.
*{11,22,33,44,55}- memory is alloted in train like fashion.
*  0  1  2  3  4 (size -1)
*what is the value at index 5? -out of bound error
*what is the value at index 2? - 33
*name,tyoe,size,syntax: type[size] name;
*"marks", int , 5,syntax : int[5] marks;
*/

import  java.util.*;
public class array {
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);

        double[] marks;// Declaration
        marks=new double[4];//Dynamically allocate memory

        // Input
        System.out.println("Enter any 4 values:");
        for(int i=0;i<4;i++){// i-> 0 to 4
            marks[i]=sc.nextDouble();
        }
        //Output
         System.out.println("The array values are:");
         for (int i=0;i<4;i++){
            System.out.println(marks[i]);
         }
    }
} 
